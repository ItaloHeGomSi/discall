#!/bin/sh
# =============================================================================
# pre-push hook — Clean Code & Quality Engineer
#
# Instalação:
#   cp .agents/skills/clean_code_quality_engineer/scripts/pre-push .git/hooks/pre-push
#   chmod +x .git/hooks/pre-push
#
# Ou via pre-commit framework:
#   Ver .pre-commit-config.yaml na raiz do projeto.
#
# Comportamento:
#   - Executa ruff (linting + style)
#   - Executa radon (complexidade ciclomática)
#   - Bloqueia o push se CC > 15 ou erros críticos de linting
# =============================================================================

echo ""
echo "🧹 Clean Code & Quality Engineer — Verificação Pré-Push"
echo "══════════════════════════════════════════════════════════"

# Coletar arquivos Python modificados em relação à main
ARQUIVOS_MODIFICADOS=$(git diff --name-only origin/main...HEAD | grep "\.py$")

if [ -z "$ARQUIVOS_MODIFICADOS" ]; then
    echo "  ✅ Nenhum arquivo Python modificado. Push liberado."
    exit 0
fi

echo "  Arquivos Python a auditar:"
echo "$ARQUIVOS_MODIFICADOS" | while read f; do echo "    - $f"; done
echo ""

BLOQUEADO=0

# ──────────────────────────────────────────────
# 1. Ruff — Linting e Estilo
# ──────────────────────────────────────────────
echo "  ⚡ Executando ruff..."
python -m ruff check $ARQUIVOS_MODIFICADOS --select E,F,W,C,B,S --quiet
RUFF_CODE=$?

if [ $RUFF_CODE -ne 0 ]; then
    echo "  🟠 ruff encontrou problemas. Revise antes do push."
    BLOQUEADO=1
else
    echo "  ✅ ruff: sem problemas críticos."
fi

# ──────────────────────────────────────────────
# 2. Radon — Complexidade Ciclomática
# ──────────────────────────────────────────────
echo ""
echo "  🔢 Analisando complexidade ciclomática (radon)..."
ALTA_CC=$(python -m radon cc $ARQUIVOS_MODIFICADOS -s --min C 2>/dev/null)

if [ -n "$ALTA_CC" ]; then
    echo "  🟠 Funções com complexidade ciclomática alta (CC ≥ C):"
    echo "$ALTA_CC" | head -20
    echo ""
    echo "  Recomendação: refatorar funções com CC > 10."
    # Apenas bloqueia se CC for extremamente alta (grau F = CC > 25)
    CRITICA=$(python -m radon cc $ARQUIVOS_MODIFICADOS -s --min F 2>/dev/null)
    if [ -n "$CRITICA" ]; then
        echo "  🔴 BLOCKER: Funções com CC > 25 detectadas!"
        BLOQUEADO=1
    fi
else
    echo "  ✅ radon: complexidade ciclomática dentro do limite."
fi


# ──────────────────────────────────────────────
# 3. Veredicto Final
# ──────────────────────────────────────────────
echo ""
echo "══════════════════════════════════════════════════════════"
if [ $BLOQUEADO -eq 1 ]; then
    echo "  🚫 PUSH BLOQUEADO — Corrija os problemas acima antes de enviar."
    echo "  Dica: Execute o agente de auditoria para um relatório completo:"
    echo "        python .agents/skills/clean_code_quality_engineer/scripts/clean_code_audit.py --staged"
    echo "══════════════════════════════════════════════════════════"
    echo ""
    exit 1
else
    echo "  ✅ PUSH LIBERADO — Código passou na verificação de qualidade."
    echo "══════════════════════════════════════════════════════════"
    echo ""
    exit 0
fi
